# LLM endpoints (OpenAI-compatible)
LLM_MINIMAX_BASE_URL=https://api.minimax.chat/v1
LLM_MINIMAX_API_KEY=
LLM_MINIMAX_MODEL=MiniMax-Text-2.7

LLM_KIMI_BASE_URL=https://api.moonshot.ai/v1
LLM_KIMI_API_KEY=
LLM_KIMI_MODEL=kimi-k2-0905-preview

# Paths
KB_ROOT=./kb
GAP_LOG_ROOT=./gap-log

# Service
INTEL_ENGINE_HOST=0.0.0.0
INTEL_ENGINE_PORT=8000

# Git auto-commit
GIT_AUTHOR_NAME=Intel Engine
GIT_AUTHOR_EMAIL=intel-engine@boldr.local

# Slack (set later)
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=

# last30days CLI integration (Plan 4)
# Path to the vendored last30days.py script (the v3.0.5 install bundled with the last30days skill works fine)
LAST30DAYS_SCRIPT=/Users/jon/.claude/plugins/cache/last30days-skill/last30days/3.0.5/scripts/last30days.py
# Python interpreter that has the last30days requirements installed (must be 3.12+)
LAST30DAYS_PYTHON=python3
# Optional save directory; if unset the runner uses a tempdir and discards the markdown
LAST30DAYS_SAVE_DIR=
