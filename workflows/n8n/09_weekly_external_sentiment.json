        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {"timeout": 60000}
      },
      "id": "d0e1f2a3-b4c5-6789-defa-890123456789",
      "name": "POST /sentiment/persist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 300]
    }
  ],
