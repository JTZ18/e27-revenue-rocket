{
  "name": "01 — Intake and Traversal",
  "nodes": [
    {
      "id": "gs-trigger",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "position": [250, 300],
      "parameters": {
        "event": "rowAdded",
        "sheetName": "tickets_input",
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "normalize",
      "name": "Normalise to CommonEvent",
      "type": "n8n-nodes-base.function",
      "position": [450, 300],
      "parameters": {
        "jsCode": "const row = $input.first().json;\nreturn [{\n  json: {\n    event_id: `evt_${row.ticket_id}_${Date.now()}`,\n    source: 'google_sheet',\n    channel_meta: { row_index: row.__row_number || 0 },\n    customer: { id: `anon_${row.ticket_id}`, name: row.customer_name },\n    subject: row.subject || null,\n    body: row.body,\n    ts: row.received_at || new Date().toISOString(),\n    attachments: []\n  }\n}];"
      }
    },
    {
      "id": "post-traverse",
      "name": "POST /traverse",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/traverse",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    },
    {
      "id": "if-answerable",
      "name": "answerable?",
      "type": "n8n-nodes-base.if",
      "position": [850, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.can_answer_fully }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "gmail-draft",
      "name": "Create Gmail Draft",
      "type": "n8n-nodes-base.gmail",
      "position": [1050, 200],
      "parameters": {
        "operation": "createDraft",
        "to": "={{ $('Normalise to CommonEvent').item.json.customer.name }} <customer@example.com>",
        "subject": "Re: {{ $('Normalise to CommonEvent').item.json.subject || 'Your enquiry' }}",
        "message": "={{ $('POST /traverse').item.json.draft_reply }}",
        "options": {
          "labelIds": ["agent-drafts"]
        }
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
    {
      "id": "post-gap",
      "name": "POST /gap",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1050, 400],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/gap",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({\n  source_event_id: $('Normalise to CommonEvent').item.json.event_id,\n  customer_question: $('Normalise to CommonEvent').item.json.body,\n  missing_info: $('POST /traverse').item.json.missing_info,\n  themes_detected: $('POST /traverse').item.json.themes_detected,\n  persona_hints: $('POST /traverse').item.json.persona_hints\n}) }}",
        "options": {}
      }
    },
    {
      "id": "slack-gap-card",
      "name": "Post Slack Gap Card",
      "type": "n8n-nodes-base.slack",
      "position": [1250, 400],
      "parameters": {
        "operation": "post",
        "channel": "={{ $env.SLACK_APPROVAL_CHANNEL }}",
        "text": "New knowledge gap — please resolve",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "header",
              "text": {
                "type": "plain_text",
                "text": "New Knowledge Gap"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Customer question:*\n> {{$('POST /gap').item.json.customer_question}}"
              }
            },
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*Missing info:*\n• {{$('POST /gap').item.json.missing_info.join('\\n• ')}}"
              }
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "Resolve this gap"
                  },
                  "style": "primary",
                  "action_id": "resolve_gap",
                  "value": "{{$('POST /gap').item.json.gap_id}}"
                }
              ]
            }
          ]
        }
      },
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Google Sheets Trigger": {
      "main": [
        [
          {
            "node": "Normalise to CommonEvent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalise to CommonEvent": {
      "main": [
        [
          {
            "node": "POST /traverse",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /traverse": {
      "main": [
        [
          {
            "node": "answerable?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "answerable?": {
      "main": [
        [
          {
            "node": "Create Gmail Draft",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "POST /gap",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /gap": {
      "main": [
        [
          {
            "node": "Post Slack Gap Card",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}
