{
  "name": "08_weekly_conflict_digest",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"field": "weeks", "weekday": 1, "triggerAtHour": 11}]}
      },
      "name": "Cron Mon 11:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.INTEL_ENGINE_URL }}/kb/summary",
        "options": {"timeout": 30000}
      },
      "name": "GET /kb/summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "jsCode": "const today = new Date().toISOString().slice(0,10);\nreturn [{ json: { kb_entries: $json.entries, week_end: today }}];"
      },
      "name": "Shape payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.INTEL_ENGINE_URL }}/conflicts/digest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {"timeout": 120000}
      },
      "name": "POST /conflicts/digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_CS_CHANNEL }}",
        "text": "Weekly KB conflict digest",
        "otherOptions": {"blocks": "={{ JSON.stringify($json.slack_blocks) }}"}
      },
      "name": "Slack: post digest",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Cron Mon 11:00": {"main": [[{"node": "GET /kb/summary", "type": "main", "index": 0}]]},
    "GET /kb/summary": {"main": [[{"node": "Shape payload", "type": "main", "index": 0}]]},
    "Shape payload": {"main": [[{"node": "POST /conflicts/digest", "type": "main", "index": 0}]]},
    "POST /conflicts/digest": {"main": [[{"node": "Slack: post digest", "type": "main", "index": 0}]]}
  },
  "settings": {}
}
