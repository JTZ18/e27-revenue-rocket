        "jsonBody": "={\n  \"trigger_id\": {{ JSON.stringify($json.trigger_id) }},\n  \"view\": {\n    \"type\": \"modal\",\n    \"callback_id\": \"edit_kb_entry\",\n    \"private_metadata\": {{ JSON.stringify($json.gap_id) }},\n    \"title\": { \"type\": \"plain_text\", \"text\": \"Edit KB draft\" },\n    \"submit\": { \"type\": \"plain_text\", \"text\": \"Submit edits\" },\n    \"close\": { \"type\": \"plain_text\", \"text\": \"Discard\" },\n    \"blocks\": [\n      { \"type\": \"input\", \"block_id\": \"edit_title\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"title\", \"initial_value\": {{ JSON.stringify($json.actions[0].value | json: parse | _get: 'frontmatter' | _get: 'title') }} }, \"label\": { \"type\": \"plain_text\", \"text\": \"Title\" } },\n      { \"type\": \"input\", \"block_id\": \"edit_slug\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"slug\", \"initial_value\": {{ JSON.stringify($json.actions[0].value | json: parse | _get: 'frontmatter' | _get: 'slug') }} }, \"label\": { \"type\": \"plain_text\", \"text\": \"Slug\" } },\n      { \"type\": \"input\", \"block_id\": \"edit_domain\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"domain\", \"initial_value\": {{ JSON.stringify($json.actions[0].value | json: parse | _get: 'frontmatter' | _get: 'domain') }} }, \"label\": { \"type\": \"plain_text\", \"text\": \"Domain (spec | pricing | policy | faq)\" } },\n      { \"type\": \"input\", \"block_id\": \"edit_body\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"body\", \"initial_value\": {{ JSON.stringify($json.actions[0].value | json: parse | _get: 'body') }}, \"multiline\": true }, \"label\": { \"type\": \"plain_text\", \"text\": \"Body\" } }\n    ]\n  }\n}",
        "options": {}
