{
  "name": "02 — Gap Resolution Handler",
  "nodes": [
    {
      "id": "slack-webhook",
      "name": "Slack interactivity webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-interactivity",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "slack-interactivity"
    },
    {
      "id": "parse-payload",
      "name": "Parse Slack payload",
      "type": "n8n-nodes-base.function",
      "position": [450, 300],
      "parameters": {
        "jsCode": "const payload = JSON.parse($input.first().json.body.payload);\nreturn [{ json: payload }];"
      }
    },
    {
      "id": "if-type",
      "name": "type?",
      "type": "n8n-nodes-base.if",
      "position": [650, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "{{ $json.type }}",
              "rightValue": "block_actions",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "open-modal",
      "name": "Open Slack Modal",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.response_url }}",
        "sendBody": true,
        "contentType": "json",
        "body": "={ trigger_id: {{ $json.trigger_id }}, view: { type: 'modal', callback_id: 'gap_resolution', title: { type: 'plain_text', text: 'Resolve Gap' }, submit: { type: 'plain_text', text: 'Submit' }, close: { type: 'plain_text', text: 'Cancel' }, blocks: [ { type: 'input', block_id: 'resolution_text', element: { type: 'plain_text_input', action_id: 'resolution', multiline: true }, label: { type: 'plain_text', text: 'Resolution' } }, { type: 'input', block_id: 'source_note', element: { type: 'plain_text_input', action_id: 'note' }, label: { type: 'plain_text', text: 'Source / reference' } }, { type: 'input', block_id: 'resolved_by', element: { type: 'plain_text_input', action_id: 'resolver', initial_value: {{ $json.user.name }} }, label: { type: 'plain_text', text: 'Resolved by' } } ] } }",
        "options": {}
      }
    },
    {
      "id": "resolve-gap",
      "name": "POST /gap/resolve",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 400],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/gap/resolve",
        "sendBody": true,
        "contentType": "json",
        "body": "={ \"gap_id\": \"{{ $json.view.private_metadata }}\", \"resolved_by\": \"{{ $json.user.name }}\", \"resolution_text\": {{ JSON.stringify($json.view.state.values.resolution_text.resolution.value) }}, \"source_note\": {{ JSON.stringify($json.view.state.values.source_note.note.value) }} }",
        "options": {}
      }
    },
    {
      "id": "draft-kb",
      "name": "POST /draft-kb-entry",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1050, 400],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8000/draft-kb-entry",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ gap_id: $('POST /gap/resolve').item.json.gap_id }) }}",
        "options": {}
      }
    },
    {
      "id": "slack-approval",
      "name": "Post KB Approval Message",
      "type": "n8n-nodes-base.slack",
      "position": [1250, 400],
      "parameters": {
        "operation": "post",
        "channel": "={{ $env.SLACK_APPROVAL_CHANNEL }}",
        "text": "KB entry drafted — approve to commit?",
        "blocksUi": {
          "blocksValues": [
            {
              "type": "section",
              "text": {
                "type": "mrkdwn",
                "text": "*KB entry drafted for approval*\n\n*Slug:* {{$('POST /draft-kb-entry').item.json.frontmatter.slug}}\n*Title:* {{$('POST /draft-kb-entry').item.json.frontmatter.title}}\n*Domain:* {{$('POST /draft-kb-entry').item.json.frontmatter.domain}}"
              }
            },
            {
              "type": "actions",
              "elements": [
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "Approve & commit to KB"
                  },
                  "style": "primary",
                  "action_id": "approve_kb",
                  "value": "{{$('POST /draft-kb-entry').item.json.frontmatter.slug}}"
                },
                {
                  "type": "button",
                  "text": {
                    "type": "plain_text",
                    "text": "Reject"
                  },
                  "style": "danger",
                  "action_id": "reject_kb",
                  "value": "reject"
                }
              ]
            }
          ]
        }
      },
      "credentials": {
        "slackApi": {
          "id": "",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Slack interactivity webhook": {
      "main": [
        [
          {
            "node": "Parse Slack payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Slack payload": {
      "main": [
        [
          {
            "node": "type?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "type?": {
      "main": [
        [
          {
            "node": "Open Slack Modal",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "POST /gap/resolve",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /gap/resolve": {
      "main": [
        [
          {
            "node": "POST /draft-kb-entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST /draft-kb-entry": {
      "main": [
        [
          {
            "node": "Post KB Approval Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null
}
