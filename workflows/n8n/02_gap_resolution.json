    {
      "parameters": {
        "method": "POST",
        "url": "https://slack.com/api/views.open",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "slackApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"trigger_id\": {{ JSON.stringify($json.trigger_id) }},\n  \"view\": {\n    \"type\": \"modal\",\n    \"callback_id\": \"gap_resolution\",\n    \"private_metadata\": {{ JSON.stringify($json.gap_id) }},\n    \"title\": { \"type\": \"plain_text\", \"text\": \"Resolve Gap\" },\n    \"submit\": { \"type\": \"plain_text\", \"text\": \"Submit\" },\n    \"close\": { \"type\": \"plain_text\", \"text\": \"Cancel\" },\n    \"blocks\": [\n      { \"type\": \"input\", \"block_id\": \"resolution_text\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"resolution\", \"multiline\": true }, \"label\": { \"type\": \"plain_text\", \"text\": \"How would you answer this?\" } },\n      { \"type\": \"input\", \"block_id\": \"source_note\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"note\" }, \"label\": { \"type\": \"plain_text\", \"text\": \"Source / reference\" } },\n      { \"type\": \"input\", \"block_id\": \"resolved_by\", \"element\": { \"type\": \"plain_text_input\", \"action_id\": \"resolver\", \"initial_value\": {{ JSON.stringify($json.user.name || '') }} }, \"label\": { \"type\": \"plain_text\", \"text\": \"Resolved by\" } }\n    ]\n  }\n}",
        "options": {}
      },
