    {
      "parameters": {
        "functionCode": "const raw = $input.first().json.body;\nconst payload = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst actions = payload.actions || [];\nconst firstAction = actions[0] || {};\nconst view = payload.view || {};\nreturn [{ json: {\n  type: payload.type || '',\n  action_id: firstAction.action_id || '',\n  gap_id: firstAction.value || (view.private_metadata || ''),\n  trigger_id: payload.trigger_id || (view.trigger_id || ''),\n  user: payload.user || (view.app_metadata && view.app_metadata.user) || {},\n  callback_id: view.callback_id || '',\n  view_state: view.state?.values || {},\n  private_metadata: view.private_metadata || ''\n} }];"
      },
      "id": "75af8a86-a497-4542-b181-3e9eb08ddd00",
